// 状態遷移の記述（jssm 互換の FSL）
//
// 状態×イベントの網羅チェックがここから出ます。
// **二重送信・二重決済・例外経路の欠落**は、ほぼこのチェックで出ます。
//
// ディレクティブ
//   @events      起こりうるイベントの全部。ここに書いたものが網羅の対象になる
//   @terminal    終端状態。ここから先が無くて正しいもの
//   @impossible  「起こり得ない」と判断したマス。**判断した記録が残ることが大事**
//   @area        どの領域の話か（観点の重み付けに使う）
//   @depends_on  この遷移図を確定させるのに必要な論点

machine_name: 注文ステータス;

// @area: A-04
// @events: submit, pay, timeout, accept, ship, deliver, cancel, refund
// @terminal: delivered, cancelled
// @depends_on: Q-001
// @impossible: draft x pay      // 未送信の注文に決済は発生しない
// @impossible: draft x timeout

draft             'submit'  -> pending_payment;
pending_payment   'pay'     -> paid;
pending_payment   'timeout' -> cancelled;
pending_payment   'cancel'  -> cancelled;
paid              'accept'  -> preparing;
preparing         'ship'    -> ready_for_pickup;
ready_for_pickup  'deliver' -> delivered;
